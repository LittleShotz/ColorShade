<Window x:Class="ColorShade.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ColorShade" Style="{StaticResource {x:Type Window}}" Width="670" Height="830" MinWidth="540" MinHeight="580"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28">
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="ColorShade" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Your game settings. Your desktop, restored." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="EnabledLabel" Text="Enabled" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <ToggleButton x:Name="EnabledToggle" Style="{StaticResource EnableSwitch}"
                        AutomationProperties.Name="Enable automatic display adjustment"
                        Checked="Enabled_Changed" Unchecked="Enabled_Changed"/>
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="18">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#A2AFC3" VerticalAlignment="Top" Margin="0,6,13,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="StatusText" Text="Starting recovery helper…" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock x:Name="BackendText" Text="Display-level controls" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="PRESET" FontSize="11" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <ComboBox x:Name="PresetCombo" DisplayMemberPath="Name" SelectionChanged="Preset_Changed" AutomationProperties.Name="Preset"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,22">
            <Button Content="Save" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="New" Click="New_Click" Margin="0,0,8,0"/>
            <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click"/>
            <TextBlock x:Name="PresetHint" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid><TextBlock Text="Digital Vibrance" FontWeight="SemiBold"/>
            <TextBlock x:Name="VibranceValue" Text="50%" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
          </Grid>
          <Slider x:Name="VibranceSlider" Value="50" ValueChanged="Slider_Changed" AutomationProperties.Name="Digital vibrance or contrast fallback"/>
          <Grid Margin="0,0,0,22"><TextBlock Text="0%" Style="{StaticResource Muted}"/>
            <TextBlock Text="50 = desktop level" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="100%" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
          </Grid>
          <Grid><TextBlock Text="Display Brightness / Gamma" FontWeight="SemiBold"/>
            <TextBlock x:Name="BrightnessValue" Text="50%" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/>
          </Grid>
          <Slider x:Name="BrightnessSlider" Value="50" ValueChanged="Slider_Changed" AutomationProperties.Name="Display brightness gamma"/>
          <Grid><TextBlock Text="Darker" Style="{StaticResource Muted}"/>
            <TextBlock Text="50 = desktop level" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            <TextBlock Text="Brighter" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
          </Grid>
          <TextBlock Text="Uses display saturation when available. The fallback adjusts contrast. Brightness changes image gamma, not the monitor backlight."
                     Style="{StaticResource Muted}" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="18">
        <StackPanel>
          <WrapPanel>
            <Button x:Name="TestButton" Content="Test for 10 seconds" Click="Test_Click" Background="#83ACF7" Foreground="#101722" BorderBrush="#A5C3FB" Margin="0,0,10,8"/>
            <Button Content="Restore / Retry" Click="Restore_Click" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock Text="Test previews this window’s monitor. During play, ColorShade follows the monitor containing the foreground Rust window."
                     Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          <TextBlock x:Name="MonitorText" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Grid Margin="2,4,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <CheckBox x:Name="StartupCheck" Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
          <TextBlock Text="Closing this window keeps ColorShade in the tray." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Exit" Click="Exit_Click" VerticalAlignment="Top"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
