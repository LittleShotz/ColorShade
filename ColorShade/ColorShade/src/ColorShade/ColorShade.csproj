<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>ColorShade.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ColorShade</AssemblyName>
    <Version>1.0.0</Version>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- WPF owns DPI through the manifest. WinForms is used only for NotifyIcon,
         so the WinForms ApplicationConfiguration DPI recommendation does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ColorShade.Core/ColorShade.Core.csproj" /></ItemGroup>
</Project>
